{
  "name": "freeboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet, offline-first whiteboard for learning and thinking.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "node scripts/package.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "format": "prettier --write src tests scripts *.json *.html *.ts .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.json *.html *.ts .github/workflows/*.yml"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.2.8",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.4",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "prettier": "3.9.10"
  },
  "overrides": {
    "nanoid@<4": "3.3.20",
    "nanoid@>=4 <6": "5.1.16",
    "lodash-es": "4.18.1",
    "sass": "1.105.2",
    "mermaid": "12.2.0",
    "chevrotain": "11.2.0",
    "katex": "0.19.0"
  }
}
